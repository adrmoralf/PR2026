# Configuración de la SIMULACIÓN (independiente de ../.env, que es la del robot real)
ROBOT_NAMESPACE=rosbot2r
CONTROLLER=dwb          # mismos parámetros de Nav2 que el robot: ../config/nav2_dwb_params.yaml
SLAM=True               # True: crea el mapa mientras navega. False: usa maps/map.yaml + AMCL
SAVE_MAP_PERIOD=15
ROS_DOMAIN_ID=42        # distinto del robot para no mezclar tópicos
# LIBGL_ALWAYS_SOFTWARE=1  # descomentar si Gazebo/RViz fallan con la GPU Intel
